# Entorno de pruebas local del stack escalable (sin claves reales). Se versiona: no contiene secretos.
# Uso: docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.prod.local --profile local-db up -d --build
API_ENV_FILE=.env.prod.local
API_IMAGE=closer-api:local
WEB_IMAGE=closer-web:local
HTTP_PORT=8080

NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:8080
# A través de PgBouncer (modo transacción → pgbouncer=true desactiva las sentencias preparadas de Prisma)
DATABASE_URL=postgresql://closer:closer@pgbouncer:5432/closer?pgbouncer=true&connection_limit=25&pool_timeout=20
DIRECT_DATABASE_URL=postgresql://closer:closer@postgres:5432/closer
AUTH_JWT_SECRET=local-scale-secret-de-al-menos-32-caracteres
AUTH_DEV_LOGIN=true
AI_PROVIDER=fake
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_VOICE_MODE=mock
