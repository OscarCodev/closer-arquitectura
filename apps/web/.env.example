# URL pública del backend (NestJS)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ─── Autenticación ───────────────────────────────────────────
# supabase → login real con Supabase Auth (Google / magic link)
# dev      → login local sin Supabase, usa POST /auth/dev-token del backend (desarrollo y pruebas E2E)
NEXT_PUBLIC_AUTH_MODE=dev

# Supabase: Project Settings → API → "Project URL" y "anon public" (o "publishable") key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Voz ─────────────────────────────────────────────────────
# gemini → llamada real por voz con Gemini Live · mock → guion simulado sin micrófono (E2E y demos sin costo)
NEXT_PUBLIC_VOICE_MODE=mock
