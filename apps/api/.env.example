# ─── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000

# ─── Base de datos (PostgreSQL) ──────────────────────────────
# Local (Docker): postgresql://closer:closer@localhost:5432/closer
# Supabase: Project Settings → Database → Connection string.
#   DATABASE_URL        = "Transaction pooler" (puerto 6543) + ?pgbouncer=true&connection_limit=5
#   DIRECT_DATABASE_URL = "Direct connection" o "Session pooler" (puerto 5432), usada solo por las migraciones
DATABASE_URL=postgresql://closer:closer@localhost:5432/closer?schema=public&connection_limit=10
DIRECT_DATABASE_URL=postgresql://closer:closer@localhost:5432/closer?schema=public

# ─── Caché y rate limit (Redis) ──────────────────────────────
# Local (Docker): redis://localhost:6379   ·   Upstash: rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379

# ─── Autenticación (Supabase Auth) ───────────────────────────
# Supabase: Project Settings → API.
#   SUPABASE_URL      → "Project URL" (se usa para validar tokens con las JWT Signing Keys / JWKS)
#   AUTH_JWT_SECRET   → "JWT Secret" (Legacy JWT secret). Si tu proyecto usa claves asimétricas puedes dejar el de desarrollo.
SUPABASE_URL=
AUTH_JWT_SECRET=dev-secret-cambia-esto-por-uno-largo-de-32-caracteres
# Habilita POST /api/v1/auth/dev-token (solo desarrollo, pruebas E2E y k6). NUNCA en producción.
AUTH_DEV_LOGIN=true

# ─── IA (Gemini) ─────────────────────────────────────────────
# gemini → usa la API real (requiere GEMINI_API_KEY) · fake → respuestas deterministas (pruebas y k6, sin costo)
AI_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# ─── Soporte (opcional) ──────────────────────────────────────
SUPPORT_WEBHOOK_URL=
